# Never commit .env. Never put real values in this file.

# ===== App =====
APP_ENV=development
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:8000

# ===== PayPal (sandbox) =====
# developer.paypal.com > Apps & Credentials (Sandbox) > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
DEFAULT_CURRENCY=USD
# Rebookly's own PayPal merchant ID (sandbox: your sandbox business account's Account ID)
PAYPAL_PARTNER_MERCHANT_ID=
# true in production: businesses must connect their own PayPal account before taking bookings
PAYPAL_REQUIRE_CONNECTED_ACCOUNT=false

# ===== Supabase (filled in during Phase 2) =====
# Project Settings in the Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ===== AI (OpenAI) =====
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_FAST=
AI_TIMEOUT_SECONDS=30

# ===== AI monitoring (Langfuse) =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=true
AI_MAX_OUTPUT_TOKENS=8000

# ===== Location (geocoding) =====
# Development: OpenStreetMap Nominatim (free, ~1 request/second, needs a real contact in the User-Agent).
# Production: a Nominatim-compatible service, e.g. LocationIQ (set its base URL and API key).
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_API_KEY=
GEOCODER_USER_AGENT=Rebookly/0.1 (contact: you@example.com)
GEOCODER_MIN_INTERVAL_SECONDS=1.0

# ===== Notifications (email) =====
# console = write emails to the server log (development); resend = send for real
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Rebookly <onboarding@resend.dev>

# ===== Development only: must be false in production =====
ENABLE_DEV_ROUTES=true
SIMULATED_CLOCK=true

# ===== Data protection =====
# Generate with the commands in the README. Losing DATA_ENCRYPTION_KEY makes stored phone numbers unreadable.
DATA_ENCRYPTION_KEY=
PHONE_HASH_KEY=

# Background jobs. Leave true; set false only when debugging without them.
ENABLE_JOBS=true


   # A SEPARATE Supabase project used only by integration tests. Every table in it is emptied by the tests.
TEST_DATABASE_URL=postgresql+asyncpg://postgres.<test-project-ref>:<password>@aws-...pooler.supabase.com:5432/postgres